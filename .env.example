# Local party setup does not use this file. Run ./scripts/party-up.sh.
# It writes the machine-local .env.party, which must stay out of git.
#
# Hosted deployment of the web app. Set these in the host's environment.
# Auth secrets belong to the Convex deployment, not the web host.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=https://example.com
# Required for the production `vercel-build`, which deploys Convex before the
# web application is built:
CONVEX_DEPLOY_KEY=prod:your-deploy-key
